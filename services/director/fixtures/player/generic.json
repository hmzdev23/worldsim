{
  "schema_version": "0.1",
  "fixture": "generic",
  "title": "Any prompted scenario",
  "summary": "Used for model-generated runs, which have no scenario-specific catalogue. Every figure is a simulated estimate.",
  "label": "SIMULATED",
  "variables": {
    "fixed": { "place": "from the prompt", "hazard": "from the prompt", "start": "run start", "baseline_population": null },
    "independent": [
      { "name": "response_speed", "label": "Response speed", "options": ["normal", "fast"], "default": "normal" },
      { "name": "outside_aid", "label": "Outside aid requested", "options": ["no", "yes"], "default": "no" },
      { "name": "relief_budget_musd", "label": "Relief budget (fictional US$ million)", "range": [0, 500], "default": 0 }
    ],
    "dependent": [
      { "name": "affected_countries", "label": "Countries affected", "measure": "affected_countries", "better": "lower", "scale": 0.3, "weight": 1 },
      { "name": "peak_severity", "label": "Peak severity", "measure": "peak_severity", "better": "lower", "scale": 0.3, "weight": 1 },
      { "name": "deaths", "label": "Deaths (fictional estimate)", "measure": "impact", "key": "deaths", "better": "lower", "scale": 0.3, "weight": 2 },
      { "name": "time_to_first_aid", "label": "Time to first outside aid", "measure": "time_to_first_aid", "better": "lower", "scale": 0.5, "weight": 1 }
    ]
  },
  "triggers": {
    "rules": [
      { "id": "severe", "kind": "severity", "at_least": 0.6, "label": "A severe event" },
      { "id": "new_region", "kind": "new_region", "label": "A new country is affected" },
      { "id": "new_outbreak_place", "kind": "new_outbreak_place", "label": "An outbreak is reported in a new place" }
    ],
    "min_gap_fraction": 0.15,
    "defer_fraction": 0.03,
    "max_deferrals": 2
  },
  "roles": [
    { "id": "crisis_coordinator", "title": "National crisis coordinator", "summary": "Fictional role: coordinates the national response." },
    { "id": "aid_director", "title": "Aid agency director", "summary": "Fictional role: directs an international relief agency." }
  ],
  "actions": [
    {
      "id": "fast_response", "label": "Speed up the emergency response",
      "tradeoff": "Reduces harm sooner; costs more and strains responders.",
      "roles": ["crisis_coordinator"], "event_types": ["*"],
      "sets": { "response_speed": "fast" }, "cost": 4,
      "intervention": { "type": "government_response", "severity": 0.3 },
      "effects": { "severity_scale": { "*": 0.9 }, "impacts_scale": { "deaths": 0.85, "injuries": 0.85, "economic_loss_usd": 1.05 } }
    },
    {
      "id": "relief_package", "label": "Announce a relief package",
      "tradeoff": "Softens losses for families and firms; adds public debt.",
      "roles": ["crisis_coordinator", "aid_director"], "event_types": ["*"],
      "sets": { "relief_budget_musd": 200 }, "cost": 3,
      "intervention": { "type": "government_response", "severity": 0.2 },
      "effects": { "impacts_scale": { "economic_loss_usd": 0.9 }, "severity_scale": { "economic_shock": 0.8, "civil_unrest": 0.8 } }
    },
    {
      "id": "request_aid", "label": "Request outside aid now",
      "tradeoff": "Brings help sooner; depends on partners' timelines.",
      "roles": ["crisis_coordinator", "aid_director"], "event_types": ["*"],
      "sets": { "outside_aid": "yes" }, "cost": 2,
      "intervention": { "type": "government_response", "severity": 0.2 },
      "effects": { "shift": [{ "type": "international_aid", "minutes": -1440 }] }
    },
    {
      "id": "fund_partners", "label": "Fund local partners",
      "tradeoff": "Builds local capacity; slow to show results.",
      "roles": ["aid_director"], "event_types": ["*"],
      "cost": 2,
      "intervention": { "type": "international_aid", "severity": 0.2 },
      "effects": { "impacts_scale": { "injuries": 0.9 } }
    },
    {
      "id": "public_briefing", "label": "Give a public briefing",
      "tradeoff": "Builds trust at little cost; little direct effect.",
      "roles": ["crisis_coordinator", "aid_director"], "event_types": ["*"],
      "cost": 1,
      "intervention": { "type": "government_response", "severity": 0.1 },
      "effects": { "severity_scale": { "civil_unrest": 0.85 } }
    }
  ]
}
