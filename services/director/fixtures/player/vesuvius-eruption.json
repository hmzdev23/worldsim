{
  "schema_version": "0.1",
  "fixture": "vesuvius-eruption",
  "title": "Vesuvius eruption",
  "summary": "A fictional VEI 5 eruption of Vesuvius buries towns in ash and spreads an ash cloud over southern Italy and Greece. Every figure is a simulated estimate.",
  "label": "SIMULATED",
  "variables": {
    "fixed": {
      "place": "Vesuvius, Bay of Naples (fictional scenario)",
      "hazard": "volcanic_eruption",
      "start": "DAY 1 · 09:59",
      "baseline_population": 3000000
    },
    "independent": [
      {
        "name": "evacuation_level",
        "label": "Red zone evacuation",
        "options": [
          "phased",
          "immediate"
        ],
        "default": "phased"
      },
      {
        "name": "roof_clearing",
        "label": "Roof ash clearing",
        "options": [
          "none",
          "crews"
        ],
        "default": "none"
      },
      {
        "name": "flight_policy",
        "label": "Flight policy",
        "options": [
          "normal",
          "rerouted"
        ],
        "default": "normal"
      },
      {
        "name": "shelter_places",
        "label": "Extra shelter places (fictional)",
        "range": [
          0,
          50000
        ],
        "default": 0
      },
      {
        "name": "outside_aid",
        "label": "Outside aid requested",
        "options": [
          "no",
          "yes"
        ],
        "default": "no"
      }
    ],
    "dependent": [
      {
        "name": "deaths",
        "label": "Deaths (fictional estimate)",
        "measure": "impact",
        "key": "deaths",
        "better": "lower",
        "scale": 0.4,
        "weight": 3
      },
      {
        "name": "households_without_power",
        "label": "Households without power",
        "measure": "impact",
        "key": "households_without_power",
        "better": "lower",
        "scale": 0.4,
        "weight": 1
      },
      {
        "name": "economic_loss_usd",
        "label": "Economic losses (fictional US$)",
        "measure": "impact",
        "key": "economic_loss_usd",
        "better": "lower",
        "scale": 0.3,
        "weight": 1
      },
      {
        "name": "time_to_first_aid",
        "label": "Time to first outside aid",
        "measure": "time_to_first_aid",
        "better": "lower",
        "scale": 0.5,
        "weight": 1
      }
    ]
  },
  "triggers": {
    "rules": [
      {
        "id": "severe",
        "kind": "severity",
        "at_least": 0.6,
        "label": "A severe event"
      },
      {
        "id": "new_region",
        "kind": "new_region",
        "label": "A new country is affected"
      },
      {
        "id": "follow_on",
        "kind": "event_type",
        "types": [
          "contamination",
          "infrastructure_failure"
        ],
        "label": "Ash spreads"
      }
    ],
    "min_gap_minutes": 240,
    "defer_minutes": 60,
    "max_deferrals": 2
  },
  "roles": [
    {
      "id": "crisis_coordinator",
      "title": "National crisis coordinator",
      "summary": "Fictional role: coordinates the national response."
    },
    {
      "id": "aid_director",
      "title": "Aid agency director",
      "summary": "Fictional role: directs an international relief agency."
    }
  ],
  "actions": [
    {
      "id": "widen_evacuation",
      "label": "Evacuate the whole red zone now",
      "tradeoff": "Gets everyone clear of the volcano; a huge, crowded move.",
      "roles": [
        "crisis_coordinator"
      ],
      "event_types": [
        "volcanic_eruption",
        "evacuation",
        "contamination"
      ],
      "sets": {
        "evacuation_level": "immediate"
      },
      "cost": 4,
      "intervention": {
        "type": "evacuation",
        "severity": 0.4
      },
      "effects": {
        "impacts_scale": {
          "deaths": 0.45,
          "injuries": 0.7,
          "displaced": 1.1,
          "sheltered": 1.2
        },
        "consequences": [
          {
            "after_minutes": 60,
            "type": "evacuation",
            "kind": "side_effect",
            "severity": 0.3,
            "description": "Simulated: more families move into crowded shelters."
          }
        ]
      }
    },
    {
      "id": "clear_roofs",
      "label": "Send crews to clear ash from roofs",
      "tradeoff": "Prevents roof collapses; crews work in dangerous air.",
      "roles": [
        "crisis_coordinator"
      ],
      "event_types": [
        "volcanic_eruption",
        "contamination"
      ],
      "sets": {
        "roof_clearing": "crews"
      },
      "cost": 3,
      "intervention": {
        "type": "government_response",
        "severity": 0.3
      },
      "effects": {
        "impacts_scale": {
          "deaths": 0.8,
          "injuries": 0.85,
          "debris_tonnes": 0.9
        },
        "consequences": [
          {
            "after_minutes": 120,
            "type": "contamination",
            "kind": "side_effect",
            "severity": 0.2,
            "description": "Simulated: crews report breathing problems in the ash zone."
          }
        ]
      }
    },
    {
      "id": "reroute_flights",
      "label": "Reroute flights around the ash",
      "tradeoff": "Keeps some flights moving; longer routes cost more.",
      "roles": [
        "crisis_coordinator",
        "aid_director"
      ],
      "event_types": [
        "volcanic_eruption",
        "economic_shock",
        "contamination",
        "infrastructure_failure"
      ],
      "sets": {
        "flight_policy": "rerouted"
      },
      "cost": 2,
      "intervention": {
        "type": "government_response",
        "severity": 0.2
      },
      "effects": {
        "severity_scale": {
          "economic_shock": 0.7
        },
        "impacts_scale": {
          "economic_loss_usd": 0.85
        }
      }
    },
    {
      "id": "open_shelters",
      "label": "Fund extra emergency shelters",
      "tradeoff": "Keeps evacuees safer; money is spent before needs are clear.",
      "roles": [
        "aid_director"
      ],
      "event_types": [
        "evacuation",
        "volcanic_eruption",
        "infrastructure_failure"
      ],
      "sets": {
        "shelter_places": 2000
      },
      "cost": 2,
      "intervention": {
        "type": "international_aid",
        "severity": 0.2
      },
      "effects": {
        "impacts_scale": {
          "injuries": 0.85,
          "sheltered": 1.2
        }
      }
    },
    {
      "id": "request_aid",
      "label": "Request outside aid now",
      "tradeoff": "Brings help sooner; depends on partners' timelines.",
      "roles": [
        "crisis_coordinator",
        "aid_director"
      ],
      "event_types": [
        "*"
      ],
      "sets": {
        "outside_aid": "yes"
      },
      "cost": 2,
      "intervention": {
        "type": "government_response",
        "severity": 0.2
      },
      "effects": {
        "shift": [
          {
            "type": "international_aid",
            "minutes": -600
          }
        ]
      }
    },
    {
      "id": "public_briefing",
      "label": "Give a public briefing",
      "tradeoff": "Builds trust at little cost; little direct effect.",
      "roles": [
        "crisis_coordinator",
        "aid_director"
      ],
      "event_types": [
        "*"
      ],
      "cost": 1,
      "intervention": {
        "type": "government_response",
        "severity": 0.1
      },
      "effects": {
        "impacts_scale": {
          "injuries": 0.95
        }
      }
    }
  ]
}
