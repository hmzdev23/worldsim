{
  "schema_version": "0.1",
  "fixture": "pacific-tsunami",
  "title": "Pacific tsunami",
  "summary": "A fictional M9.0 earthquake off Chile sends tsunami waves across the Pacific to Peru, Hawaii and Japan. Every figure is a simulated estimate.",
  "label": "SIMULATED",
  "variables": {
    "fixed": {
      "place": "Coast of Maule, Chile (fictional scenario)",
      "hazard": "earthquake",
      "start": "DAY 1 · 04:59",
      "baseline_population": 2500000
    },
    "independent": [
      {
        "name": "evacuation_level",
        "label": "Coastal evacuation",
        "options": [
          "standard",
          "wide"
        ],
        "default": "standard"
      },
      {
        "name": "warning_reach",
        "label": "Tsunami warnings abroad",
        "options": [
          "routine",
          "early"
        ],
        "default": "routine"
      },
      {
        "name": "port_closure",
        "label": "Port closures",
        "options": [
          "late",
          "early"
        ],
        "default": "late"
      },
      {
        "name": "shelter_places",
        "label": "Extra shelter places (fictional)",
        "range": [
          0,
          50000
        ],
        "default": 0
      },
      {
        "name": "outside_aid",
        "label": "Outside aid requested",
        "options": [
          "no",
          "yes"
        ],
        "default": "no"
      }
    ],
    "dependent": [
      {
        "name": "deaths",
        "label": "Deaths (fictional estimate)",
        "measure": "impact",
        "key": "deaths",
        "better": "lower",
        "scale": 0.3,
        "weight": 3
      },
      {
        "name": "households_without_power",
        "label": "Households without power",
        "measure": "impact",
        "key": "households_without_power",
        "better": "lower",
        "scale": 0.4,
        "weight": 1
      },
      {
        "name": "economic_loss_usd",
        "label": "Economic losses (fictional US$)",
        "measure": "impact",
        "key": "economic_loss_usd",
        "better": "lower",
        "scale": 0.3,
        "weight": 1
      },
      {
        "name": "time_to_first_aid",
        "label": "Time to first outside aid",
        "measure": "time_to_first_aid",
        "better": "lower",
        "scale": 0.5,
        "weight": 1
      }
    ]
  },
  "triggers": {
    "rules": [
      {
        "id": "severe",
        "kind": "severity",
        "at_least": 0.6,
        "label": "A severe event"
      },
      {
        "id": "new_region",
        "kind": "new_region",
        "label": "The waves reach a new country"
      }
    ],
    "min_gap_minutes": 180,
    "defer_minutes": 45,
    "max_deferrals": 2
  },
  "roles": [
    {
      "id": "crisis_coordinator",
      "title": "National crisis coordinator",
      "summary": "Fictional role: coordinates Chile's national response."
    },
    {
      "id": "warning_centre",
      "title": "Pacific warning centre chief",
      "summary": "Fictional role: runs the regional tsunami warning centre."
    },
    {
      "id": "aid_director",
      "title": "Aid agency director",
      "summary": "Fictional role: directs an international relief agency."
    }
  ],
  "actions": [
    {
      "id": "widen_evacuation",
      "label": "Order a wider coastal evacuation",
      "tradeoff": "Moves more people to high ground; shelters fill up.",
      "roles": [
        "crisis_coordinator",
        "warning_centre"
      ],
      "event_types": [
        "earthquake",
        "tsunami_warning",
        "evacuation",
        "flooding"
      ],
      "sets": {
        "evacuation_level": "wide"
      },
      "cost": 3,
      "intervention": {
        "type": "evacuation",
        "severity": 0.4
      },
      "effects": {
        "impacts_scale": {
          "deaths": 0.7,
          "missing": 0.7,
          "injuries": 0.85,
          "displaced": 1.1,
          "sheltered": 1.2
        },
        "consequences": [
          {
            "after_minutes": 90,
            "type": "evacuation",
            "kind": "side_effect",
            "severity": 0.3,
            "description": "Simulated: hillside shelters fill beyond planned capacity."
          }
        ]
      }
    },
    {
      "id": "early_warnings",
      "label": "Send early warnings to every Pacific coast",
      "tradeoff": "Gives distant coasts hours to prepare; false alarms cost trust.",
      "roles": [
        "warning_centre"
      ],
      "event_types": [
        "earthquake",
        "tsunami_warning"
      ],
      "sets": {
        "warning_reach": "early"
      },
      "cost": 2,
      "intervention": {
        "type": "government_response",
        "severity": 0.3
      },
      "effects": {
        "severity_scale": {
          "flooding": 0.8
        },
        "impacts_scale": {
          "deaths": 0.85,
          "injuries": 0.85
        },
        "shift": [
          {
            "type": "tsunami_warning",
            "minutes": -120
          }
        ]
      }
    },
    {
      "id": "close_ports",
      "label": "Close ports and move ships out to sea",
      "tradeoff": "Protects ships and cranes; trade stops for longer.",
      "roles": [
        "crisis_coordinator",
        "warning_centre"
      ],
      "event_types": [
        "tsunami_warning",
        "flooding",
        "economic_shock"
      ],
      "sets": {
        "port_closure": "early"
      },
      "cost": 3,
      "intervention": {
        "type": "government_response",
        "severity": 0.3
      },
      "effects": {
        "impacts_scale": {
          "debris_tonnes": 0.8,
          "economic_loss_usd": 0.9
        },
        "severity_scale": {
          "economic_shock": 0.85
        }
      }
    },
    {
      "id": "prioritise_grid",
      "label": "Restore power to hospitals and shelters first",
      "tradeoff": "Protects the most vulnerable; homes wait longer.",
      "roles": [
        "crisis_coordinator"
      ],
      "event_types": [
        "infrastructure_failure",
        "earthquake",
        "flooding"
      ],
      "cost": 3,
      "intervention": {
        "type": "government_response",
        "severity": 0.3
      },
      "effects": {
        "severity_scale": {
          "infrastructure_failure": 0.8
        },
        "impacts_scale": {
          "households_without_power": 0.75,
          "households_without_water": 0.8
        }
      }
    },
    {
      "id": "open_shelters",
      "label": "Fund extra emergency shelters",
      "tradeoff": "Keeps evacuees safer; money is spent before needs are clear.",
      "roles": [
        "aid_director"
      ],
      "event_types": [
        "earthquake",
        "tsunami_warning",
        "evacuation",
        "flooding"
      ],
      "sets": {
        "shelter_places": 20000
      },
      "cost": 2,
      "intervention": {
        "type": "international_aid",
        "severity": 0.2
      },
      "effects": {
        "impacts_scale": {
          "injuries": 0.9,
          "sheltered": 1.2
        }
      }
    },
    {
      "id": "fund_recovery",
      "label": "Fund early recovery work",
      "tradeoff": "Speeds rebuilding; money spent early may be wasted.",
      "roles": [
        "aid_director"
      ],
      "event_types": [
        "flooding",
        "infrastructure_failure",
        "economic_shock"
      ],
      "cost": 3,
      "intervention": {
        "type": "international_aid",
        "severity": 0.2
      },
      "effects": {
        "impacts_scale": {
          "economic_loss_usd": 0.9
        },
        "shift": [
          {
            "type": "recovery",
            "minutes": -720
          }
        ]
      }
    },
    {
      "id": "request_aid",
      "label": "Request outside aid now",
      "tradeoff": "Brings help sooner; depends on partners' timelines.",
      "roles": [
        "crisis_coordinator",
        "warning_centre",
        "aid_director"
      ],
      "event_types": [
        "*"
      ],
      "sets": {
        "outside_aid": "yes"
      },
      "cost": 2,
      "intervention": {
        "type": "government_response",
        "severity": 0.2
      },
      "effects": {
        "shift": [
          {
            "type": "international_aid",
            "minutes": -600
          }
        ]
      }
    },
    {
      "id": "share_forecasts",
      "label": "Share wave and damage forecasts with responders",
      "tradeoff": "Helps responders aim help; forecasts can be wrong.",
      "roles": [
        "warning_centre"
      ],
      "event_types": [
        "*"
      ],
      "cost": 1,
      "intervention": {
        "type": "government_response",
        "severity": 0.1
      },
      "effects": {
        "impacts_scale": {
          "injuries": 0.95,
          "missing": 0.9
        }
      }
    },
    {
      "id": "public_briefing",
      "label": "Give a public briefing",
      "tradeoff": "Builds trust at little cost; little direct effect.",
      "roles": [
        "crisis_coordinator",
        "warning_centre",
        "aid_director"
      ],
      "event_types": [
        "*"
      ],
      "cost": 1,
      "intervention": {
        "type": "government_response",
        "severity": 0.1
      },
      "effects": {
        "severity_scale": {
          "evacuation": 0.95
        }
      }
    }
  ]
}
