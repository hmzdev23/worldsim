      "lower_third": "SIGRÚN · GRINDAVIK",
      "narration": "This is Sigrún, in Grindavik. At three in the morning, she was packing for a flight."
    },
    {
      "scene": "eruption",
      "event_id": "evt-0001",
      "date": "DAY 1 · 03:10",
      "narration": "Then the ground opened outside town. The airport departure board started cancelling flights."
    },
    {
      "scene": "evacuation",
      "event_id": "evt-0002",
      "date": "DAY 1 · 03:50",
      "narration": "Sigrún joined the road out. A sign assured drivers the queue was moving smoothly."
    },
    {
      "scene": "shelter",
      "event_id": "evt-0003",
      "date": "DAY 1 · 07:00",
      "narration": "At the shelter, the power went out. The glowing exit sign became the room's main attraction."
    },
    {
      "scene": "airport",
      "event_id": "evt-0005",
      "date": "DAY 1 · 18:20",
      "narration": "By evening, every flight was grounded. The board still asked everyone to keep checking."
    },
    {
      "scene": "aid",
      "event_id": "evt-0006",
      "date": "DAY 2 · 01:00",
      "narration": "Day two: help from Norway. Officials posed beside the supplies before unloading them."
    },
    {
      "scene": "home-again",
      "event_id": "evt-0008",
      "date": "DAY 3 · 12:00",
      "narration": "Day three: the power came back. Her flight did not."
