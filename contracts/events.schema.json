{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldsim.local/contracts/events.schema.json",
  "title": "WORLD//SIM event batch",
  "description": "Version 0.1 (proposed in CONTRACT-001, #1; event types extended additively in CONTRACT-002). A batch of world events. The Director proposes events, the simulation validates them and marks them applied or rejected, and the newsroom and map use applied events only.",
  "type": "object",
  "required": ["schema_version", "simulation_id", "branch_id", "events"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "simulation_id": { "$ref": "#/$defs/slug" },
    "branch_id": { "$ref": "#/$defs/slug" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt-[A-Za-z0-9_-]{1,64}$"
    },
    "impacts": {
      "type": "object",
      "description": "Fictional scenario estimates: scenario-wide totals as of this event, never deltas. Read the latest applied event at or before time T to get the state at T. These never decrease: deaths, injuries, economic_loss_usd, flooded_area_km2, contaminated_area_km2, debris_tonnes, and each aid contributor's personnel and cargo_tonnes (a contributor never disappears). These are current levels and can fall: missing, displaced, sheltered, households_without_power, households_without_water. An omitted key means no estimate yet, not zero.",
      "required": ["basis"],
      "additionalProperties": false,
      "properties": {
        "basis": { "const": "fictional_estimate", "description": "Marks every number here as an invented scenario estimate." },
        "deaths": { "type": "integer", "minimum": 0 },
        "injuries": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "displaced": { "type": "integer", "minimum": 0, "description": "People evacuated or without a home right now." },
        "sheltered": { "type": "integer", "minimum": 0, "description": "Of the displaced, people in shelters right now." },
        "households_without_power": { "type": "integer", "minimum": 0 },
        "households_without_water": { "type": "integer", "minimum": 0 },
        "economic_loss_usd": { "type": "number", "minimum": 0, "description": "Direct economic loss so far, in US dollars." },
        "flooded_area_km2": { "type": "number", "minimum": 0 },
        "contaminated_area_km2": { "type": "number", "minimum": 0 },
        "debris_tonnes": { "type": "number", "minimum": 0 },
        "aid_contributors": {
          "type": "array",
          "maxItems": 50,
          "description": "Every country that has sent aid so far, with its running totals. Country names are unique.",
          "items": {
            "type": "object",
            "required": ["country"],
            "additionalProperties": false,
            "properties": {
              "country": { "type": "string", "minLength": 1, "maxLength": 80 },
              "personnel": { "type": "integer", "minimum": 0 },
              "cargo_tonnes": { "type": "number", "minimum": 0 },
              "cargo": { "type": "string", "maxLength": 120, "description": "What it has sent, such as 'water purification units'." }
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "sim_time_minutes",
        "sequence",
        "type",
        "status",
        "location",
        "severity",
        "visual",
        "payload",
        "parent_ids",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/event_id",
          "description": "Stable and unique within a simulation. Never reused across branches."
        },
        "sim_time_minutes": {
          "type": "integer",
          "minimum": 0,
          "description": "Simulated minutes since the simulation started (DAY 1 · 00:00). Never wall-clock time."
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "description": "Breaks ties between events at the same sim time. Canonical order is (sim_time_minutes, sequence)."
        },
        "type": {
          "description": "Hazards start or spread a crisis; consequences follow from them. other_hazard covers anything else and requires payload.label.",
          "enum": [
            "earthquake",
            "aftershock",
            "tsunami_warning",
            "volcanic_eruption",
            "meteor_impact",
            "extreme_weather",
            "flooding",
            "disease_outbreak",
            "military_strike",
            "nuclear_detonation",
            "cyber_attack",
            "alien_contact",
            "other_hazard",
            "infrastructure_failure",
            "government_response",
            "international_aid",
            "evacuation",
            "contamination",
            "economic_shock",
            "civil_unrest",
            "conflict_escalation",
            "ceasefire",
            "recovery"
          ]
        },
        "status": {
          "enum": ["proposed", "applied", "rejected"],
          "description": "The Director emits proposed events. Only the simulation sets applied or rejected."
        },
        "location": {
          "type": "object",
          "required": ["name", "country", "country_code", "lat", "lon"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "country": { "type": "string", "minLength": 1, "maxLength": 80 },
            "country_code": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "description": "ISO 3166-1 alpha-3 code."
            },
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "severity": { "type": "number", "minimum": 0, "maximum": 1 },
        "visual": {
          "enum": [
            "earthquake_shockwave",
            "power_grid_failure",
            "emergency_mobilization",
            "animated_transport_route",
            "breaking_news",
            "weather_disaster",
            "ash_plume",
            "impact_blast",
            "contagion_spread",
            "missile_strike",
            "nuclear_blast",
            "cyber_pulse",
            "alien_arrival",
            "evacuation_flow",
            "fallout_cloud",
            "market_shock",
            "unrest_hotspot",
            "recovery_pulse"
          ],
          "description": "Animation key for the map."
        },
        "payload": {
          "type": "object",
          "description": "Type-specific details. These keys are optional unless a rule below requires them, and other keys are allowed. Earthquake and aftershock events require magnitude and depth_km; other_hazard requires label.",
          "maxProperties": 16,
          "properties": {
            "description": { "type": "string", "maxLength": 280, "description": "One sentence about what happened." },
            "label": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Short name of the hazard, such as 'H7N9 influenza'." },
            "magnitude": { "type": "number", "minimum": 0, "maximum": 10 },
            "depth_km": { "type": "number", "minimum": 0, "maximum": 800 },
            "vei": { "type": "integer", "minimum": 0, "maximum": 8, "description": "Volcanic explosivity index." },
            "diameter_m": { "type": "number", "minimum": 0, "description": "Meteor diameter in meters." },
            "yield_kt": { "type": "number", "minimum": 0, "description": "Nuclear yield in kilotons." },
            "radius_km": { "type": "number", "minimum": 0, "maximum": 20000, "description": "Approximate affected radius, for map scale." },
            "origin": { "type": "string", "maxLength": 80, "description": "Where it comes from: the aid sender, the attacking country, or 'unknown'." },
            "target": { "type": "string", "maxLength": 80, "description": "What was hit, such as 'power grid' or 'banking'." },
            "pathogen": { "type": "string", "maxLength": 80 },
            "impacts": { "$ref": "#/$defs/impacts" }
          }
        },
        "parent_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/event_id" },
          "uniqueItems": true,
          "description": "Events that caused this one."
        },
        "provenance": {
          "type": "object",
          "required": ["source"],
          "additionalProperties": false,
          "properties": {
            "source": { "enum": ["fixture", "model", "user", "numeric"] },
            "model": { "type": "string", "maxLength": 80 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["earthquake", "aftershock"] } } },
          "then": {
            "properties": {
              "payload": {
                "required": ["magnitude", "depth_km"],
                "properties": {
                  "magnitude": { "type": "number", "minimum": 0, "maximum": 10 },
                  "depth_km": { "type": "number", "minimum": 0, "maximum": 800 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "other_hazard" } } },
          "then": { "properties": { "payload": { "required": ["label"] } } }
        }
      ]
    }
  }
}
